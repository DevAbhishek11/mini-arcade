# ---- runtime ----
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info
LOG_PRETTY=true

# ---- clustering ----
# 0 = one worker per CPU core (capped by CLUSTER_MAX_WORKERS)
CLUSTER_WORKERS=0
CLUSTER_MAX_WORKERS=4
WORKER_HEARTBEAT_MS=10000
WORKER_HEARTBEAT_TIMEOUT_MS=30000
# recycle a worker above this RSS (MB); 0 disables
WORKER_MAX_RSS_MB=0

# ---- security ----
JWT_SECRET=change-me-in-production-please-32-chars
JWT_TTL_SECONDS=2592000
CORS_ORIGINS=*
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=240
RATE_LIMIT_AUTH_MAX=20

# ---- data (both optional: the server degrades to in-memory) ----
# DATABASE_URL=postgres://arcade:arcade@localhost:5432/arcade
# REDIS_URL=redis://localhost:6379
DB_POOL_MAX=10
DB_RUN_MIGRATIONS=true

# ---- caching ----
CACHE_L1_MAX_ITEMS=2000
CACHE_L1_TTL_MS=5000
CACHE_DEFAULT_TTL_MS=30000
CACHE_LEADERBOARD_TTL_MS=15000

# ---- gameplay ----
MATCH_RECONNECT_GRACE_MS=20000
MATCH_IDLE_TIMEOUT_MS=120000
SOCKET_ACTION_RATE=30
SOCKET_ACTION_BURST=60
# fill an unmatched queue with a bot after this long (0 disables)
BOT_FILL_MS=12000
